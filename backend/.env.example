# ---- Database (Neon) -------------------------------------------------------
# Paste the connection string from Neon > Dashboard > Connect (pooled or direct both work).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Local docker-compose alternative:
# DATABASE_URL=postgresql://aerotwin:aerotwin@localhost:5432/aerotwin

# ---- Security (REQUIRED in production) --------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ADMIN_LOGIN_ID=ADMIN
ADMIN_PASSWORD=Admin@12345          # only used on FIRST start; a change is forced at first sign-in
ADMIN_NAME=DRDO System Administrator
# Comma-separated list of allowed frontend origins (your Vercel URL). "*" only for local dev.
CORS_ORIGINS=http://localhost:5173
TOKEN_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=10

# ---- Optional ------------------------------------------------------------------
INGEST_KEY=                         # set to enable POST /api/ingest/{tail} for real CAN gateways
SEED_DEMO_DRONES=true               # 5 simulated drones on an empty database
SEED_DEMO_OPERATORS=false           # true => OPR-01/OPR-02/OPR-04 with DEMO_OPERATOR_PASSWORD
DEMO_OPERATOR_PASSWORD=Operator@123
PERSIST_EVERY_N_FRAMES=60           # DB write cadence per drone (higher = fewer Neon writes)
TELEMETRY_KEEP_PER_DRONE=2000
MAX_LIVE_TWINS=12

# ---- Self-registration (login page) --------------------------------------------
# Operators can register themselves (they see nothing until an admin assigns drones).
# Admin registration works ONLY with this secret key. Leave empty => admin registration disabled.
ADMIN_REGISTRATION_KEY=
REGISTER_MAX_PER_HOUR=10            # registration attempts per IP per hour